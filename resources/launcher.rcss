/* The launcher, in the look of Melee's Main Menu and Options screens: a navy
 * grid behind a frame whose colour follows the focused plate, staggered
 * plates with a gold rim, the selected one yellow with the cursor disc, and a
 * description bar along the bottom. The art is drawn by
 * tools/launcher_art/make_launcher_art.py; the rectangles below are the ones
 * it lays out in sprites.png (2x pixels). */

@spritesheet launcher {
    src: launcher/sprites.png;
    resolution: 2x;
    plate: 0px 0px 480px 180px;
    plate-inner: 78px 40px 291px 108px;
    plate-on: 512px 0px 480px 180px;
    plate-on-inner: 590px 40px 291px 108px;
    small: 0px 180px 480px 124px;
    small-inner: 56px 210px 346px 69px;
    small-on: 512px 180px 480px 124px;
    small-on-inner: 568px 210px 346px 69px;
    small-hover: 0px 488px 480px 124px;
    small-hover-inner: 56px 518px 346px 69px;
    disc: 0px 304px 184px 184px;
    arrow-l: 192px 304px 28px 40px;
    arrow-r: 228px 304px 28px 40px;
    arrow-l-dark: 264px 304px 28px 40px;
    arrow-r-dark: 300px 304px 28px 40px;
}

div, p, h1, h2, h3 { display: block; }

body {
    font-family: "Noto Sans";  /* SemiCondensed: its files call it Noto Sans */
    font-size: 18dp;
    color: #e8e8f0;
    background-color: #07071a;
    decorator: image(launcher/backdrop.png none cover center center);
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 18dp 28dp 8dp;
    margin: 0;
    display: flex;
    flex-direction: column;
}

scrollbarvertical { width: 14dp; margin: 2dp 0; }
scrollbarvertical slidertrack { background-color: #00000080; border-radius: 7dp; }
scrollbarvertical sliderbar { background-color: #8a6a1a; border-radius: 7dp; min-height: 32dp; }
scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active { background-color: #ffcb00; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal { height: 0; }

/* ---- Frame ------------------------------------------------------------- */

#frame {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border: 4dp #3a5ae0;
    border-radius: 22dp;
    padding: 0 26dp 18dp;
    background-color: #05051440;
    transition: border-color 0.18s linear-in-out;
}
/* Melee colours each main-menu entry: VS. Mode red, 1-P Mode blue, Trophies
 * green, Options gold, Data purple; one each here, and Discord's own blurple. */
.theme-play #frame { border-color: #e0442a; }
.theme-play .stripes span { background-color: #e0442a; }
.theme-choose #frame { border-color: #3a5ae0; }
.theme-choose .stripes span { background-color: #3a5ae0; }
.theme-verify #frame { border-color: #28a850; }
.theme-verify .stripes span { background-color: #28a850; }
.theme-settings #frame { border-color: #c9a227; }
.theme-settings .stripes span { background-color: #c9a227; }
.theme-discord #frame { border-color: #5865f2; }
.theme-discord .stripes span { background-color: #5865f2; }
.theme-quit #frame { border-color: #8a4ad8; }
.theme-quit .stripes span { background-color: #8a4ad8; }

#titlebar {
    display: flex;
    align-items: center;
    height: 58dp;
    margin: -24dp 0 6dp -6dp;
    flex-shrink: 0;
}
#title, #title-sub {
    font-size: 36dp;
    font-weight: bold;
    color: #b8bccb;
    font-effect: outline(3dp #0c0c1c);
    transform: skewX(-14deg);
    background-color: #07071a;
    padding: 0 12dp 0 10dp;
}
#title-sub { display: none; color: #d8dbe8; padding-left: 4dp; }
.in-settings #title { color: #8e92a3; font-size: 26dp; }
.in-settings #title-sub { display: inline-block; }
.stripes { display: flex; height: 26dp; margin-left: 2dp; }
.stripes span {
    display: block;
    width: 7dp;
    height: 26dp;
    margin-right: 5dp;
    transform: skewX(-30deg);
    background-color: #3a5ae0;
    transition: background-color 0.18s linear-in-out;
}
#edition {
    margin-left: auto;
    margin-top: 22dp;
    font-size: 14dp;
    letter-spacing: 1dp;
    color: #9da2bb;
}

/* ---- Plates ------------------------------------------------------------- */

button {
    display: block;
    box-sizing: border-box;
    cursor: pointer;
    tab-index: auto;
    focus: auto;
    font-weight: bold;
    text-align: center;
}

/* A plate's element box carries the art's 5dp of glow on every side, so
 * stacked plates overlap by that much to touch, as Melee's do. The cursor
 * disc paints over the border box: the transparent right border puts its
 * centre on the plate's ring (make_launcher_art.py prints where that is). */
.plate {
    height: 90dp;
    padding: 0 60dp 0 42dp;
    border-right: 6dp #00000000;
    line-height: 95dp;  /* centred on the black window, which sits low */
    font-size: 40dp;
    font-weight: 800;
    color: #dba63c;
    font-effect: outline(2dp #000000);
    decorator: ninepatch(plate, plate-inner, 20dp 55.5dp 16dp 39dp);
}
.plate:hover { color: #ffe9a8; }
.plate:focus {
    color: #141008;
    font-effect: none;
    decorator: image(disc none scale-none right center) border-box,
               ninepatch(plate-on, plate-on-inner, 20dp 55.5dp 16dp 39dp);
}
/* Every plate's name leans a little, selected or not, as Melee's do. */
.plate span { display: inline-block; transform: skewX(-6deg); }
.plate:disabled { color: #6c604a; cursor: default; }
.plate:disabled:focus { color: #4c4434; }

.plate.small {
    height: 62dp;
    padding: 0 42dp 0 30dp;
    border-right: 3.5dp #00000000;
    line-height: 65dp;
    font-size: 26dp;
    decorator: ninepatch(small, small-inner, 15dp 39dp 12.5dp 28dp);
}
/* The pointer over a category, between idle and selected: pointing only
 * lights it, a click opens it (launcher.cpp, hover()). */
.plate.small:hover {
    color: #ffe9a8;
    decorator: ninepatch(small-hover, small-hover-inner, 15dp 39dp 12.5dp 28dp);
}
.plate.small.selected {
    color: #141008;
    font-effect: none;
    decorator: ninepatch(small-on, small-on-inner, 15dp 39dp 12.5dp 28dp);
}
/* The cursor on Back: the open page's plate goes back to idle. */
.on-back .plate.small.selected {
    color: #dba63c;
    font-effect: outline(2dp #000000);
    decorator: ninepatch(small, small-inner, 15dp 39dp 12.5dp 28dp);
}
.on-back .plate.small.selected:hover {
    color: #ffe9a8;
    decorator: ninepatch(small-hover, small-hover-inner, 15dp 39dp 12.5dp 28dp);
}
.plate.small:focus {
    color: #141008;
    font-effect: none;
    decorator: image(disc none contain right center) border-box,
               ninepatch(small-on, small-on-inner, 15dp 39dp 12.5dp 28dp);
}

/* ---- Main menu ---------------------------------------------------------- */

#home { flex: 1; min-height: 0; display: flex; align-items: center; }
#plates { width: 54%; max-width: 660dp; flex-shrink: 0; }
/* Melee stacks its plates touching, staggered into a wedge that points left
 * at the middle two; the lower half mirrors the upper. */
#plates .plate { width: 76%; margin-bottom: -10dp; }
#play { margin-left: 11%; }
#choose { margin-left: 5.5%; }
#verify { margin-left: 0; }
#settings { margin-left: 0; }
#discord { margin-left: 5.5%; }
#quit { margin-left: 11%; }

#side {
    flex: 1;
    min-width: 0;
    margin-left: 34dp;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: center;
}
#disc-panel {
    box-sizing: border-box;
    padding: 20dp 24dp 18dp 28dp;
    background-color: #0e1030b8;
    border: 2dp #b8bccb60;
    border-left: 6dp #b8bccb40;
    border-radius: 6dp 18dp 18dp 6dp;
}
.side-label {
    font-size: 15dp;
    font-weight: bold;
    letter-spacing: 6dp;
    color: #9da2bb;
    text-transform: uppercase;
}
#disc-name {
    font-size: 30dp;
    font-weight: bold;
    color: #ffffff;
    margin: 6dp 0 4dp;
    word-break: break-word;
}
#disc-info { font-size: 18dp; color: #d8dae6; margin: 0 0 6dp; }
.path { font-size: 13dp; color: #8f94ad; word-break: break-all; margin: 0 0 14dp; }
#status {
    font-size: 17dp;
    color: #c8f0d6;
    padding: 9dp 12dp;
    background-color: #00000070;
    border-left: 4dp #3ec070;
    border-radius: 3dp;
}
#status.error { color: #ffc8bc; border-left-color: #f0503a; background-color: #3a0c1070; }
.note { font-size: 14dp; color: #9da2bb; margin: 12dp 0 0; }
.page .note { margin: 10dp 12dp 0; }

/* The update notice, desktop only: a gold box over the disc panel. */
#update-card {
    box-sizing: border-box;
    padding: 12dp 16dp;
    margin-bottom: 14dp;
    background-color: #000000c0;
    border: 3dp #e0b030;
    border-radius: 10dp;
}
.update-badge-row { display: flex; align-items: center; }
.update-badge {
    background-color: #ffcb00;
    color: #141008;
    font-size: 13dp;
    font-weight: bold;
    letter-spacing: 2dp;
    padding: 1dp 8dp;
    margin-right: 10dp;
    transform: skewX(-12deg);
}
.update-tag { color: #ffcb00; font-size: 15dp; font-weight: bold; }
.update-title { font-size: 19dp; font-weight: bold; color: #ffffff; margin: 4dp 0 2dp; }
.update-desc { font-size: 13dp; color: #b8bccb; margin: 0; }
.update-progress-row { display: flex; align-items: center; margin-top: 8dp; }
.progress-bar-bg { flex: 1; height: 8dp; background-color: #1a1a2a; border-radius: 4dp; margin-right: 10dp; }
.progress-bar-fill { height: 100%; background-color: #ffcb00; border-radius: 4dp; }
.progress-text { font-size: 13dp; color: #ffcb00; width: 44dp; text-align: right; }
.update-actions { display: flex; margin-top: 10dp; }
button.mini {
    flex: 1;
    height: 34dp;
    line-height: 30dp;
    margin-right: 8dp;
    font-size: 15dp;
    color: #e8e8f0;
    background-color: #14142a;
    border: 2dp #8a6a1a;
    border-radius: 6dp;
    transform: skewX(-12deg);
}
button.mini:hover { border-color: #e0b030; }
button.mini:focus { background-color: #ffcb00; border-color: #fff0a0; color: #141008; }
button.mini.primary { border-color: #e0b030; }

/* ---- Settings ----------------------------------------------------------- */

#preferences { display: none; flex: 1; min-height: 0; flex-direction: row; }
.in-settings #home { display: none; }
.in-settings #preferences { display: flex; }

#categories {
    width: 28%;
    max-width: 320dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-right: 22dp;
}
#categories .plate { width: 80%; margin-bottom: -10dp; }
#tab-graphics { margin-left: 9%; }
#tab-audio { margin-left: 4.5%; }
#tab-cheats { margin-left: 0; }
#tab-controls { margin-left: 0; }
#tab-online { margin-left: 4.5%; }
#tab-launcher { margin-left: 9%; }
#back { margin-top: 22dp; margin-left: 6%; }

#settings-content {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 14dp 18dp 10dp 22dp;
    background-color: #0a0c26c8;
    border: 2dp #b8bccb50;
    border-radius: 6dp 18dp 18dp 6dp;
}
.page { display: none; }
.page.selected { display: block; }

.row {
    display: flex;
    align-items: center;
    min-height: 44dp;
    padding: 0 8dp 0 12dp;
    margin-bottom: 3dp;
    border-radius: 4dp;
    background-color: #ffffff08;
}
.row.current { background-color: #ffcb0024; }
.row .name {
    flex: 1;
    min-width: 0;
    font-size: 19dp;
    font-weight: bold;
    color: #e8e8f0;
    margin-right: 16dp;
}
.row.current .name { color: #ffd84a; }
.detail { display: block; font-size: 13dp; font-weight: normal; color: #9da2bb; }
.detail.error { color: #ff9a88; }
.badge {
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
    color: #9da2bb;
    border: 1dp #9da2bb80;
    border-radius: 3dp;
    padding: 0 5dp;
    margin-left: 6dp;
}

/* A value: the current setting between Melee's two arrows. Click or A steps
 * it forward, left and right step it either way. */
button.value {
    flex-shrink: 0;
    width: 250dp;
    height: 36dp;
    line-height: 32dp;
    padding: 0 26dp;
    font-size: 17dp;
    color: #f4f0dc;
    background-color: #00000090;
    border: 2dp #8a6a1a;
    border-radius: 5dp;
    decorator: image(arrow-l none scale-none left center), image(arrow-r none scale-none right center);
    transform: skewX(-10deg);
}
button.value.action { decorator: none; }
button.value:hover { border-color: #e0b030; color: #ffffff; }
button.value:focus {
    background-color: #ffcb00;
    border-color: #fff0a0;
    color: #141008;
    decorator: image(arrow-l-dark none scale-none left center), image(arrow-r-dark none scale-none right center);
}
button.value.action:focus { decorator: none; }
button.value:disabled { color: #6c6c7c; border-color: #3a3a4a; }
.readout { font-size: 19dp; font-weight: bold; color: #ffd84a; }

input.text, input.password {
    width: 250dp;
    height: 34dp;
    box-sizing: border-box;
    padding: 5dp 10dp;
    font-size: 17dp;
    color: #ffffff;
    background-color: #000000a0;
    border: 2dp #8a6a1a;
    border-radius: 5dp;
    cursor: text;
    tab-index: auto;
}
input.text:focus, input.password:focus { border-color: #ffcb00; }

.slider-control { display: flex; align-items: center; width: 250dp; height: 36dp; flex-shrink: 0; }
input.range { flex: 1; height: 28dp; margin-right: 12dp; cursor: pointer; tab-index: auto; }
input.range slidertrack {
    height: 8dp;
    margin-top: 10dp;
    background-color: #000000c0;
    border: 2dp #8a6a1a;
    border-radius: 4dp;
}
input.range sliderprogress {
    height: 8dp;
    margin-top: 2dp;  /* from the track, which it sits in: inside its rim */
    background-color: #e0a800;
    border-radius: 4dp;
}
input.range sliderbar {
    width: 28dp;
    height: 28dp;
    margin-left: -14dp;
    margin-right: -14dp;
    decorator: image(disc none contain center center);
}
input.range:focus slidertrack, input.range:hover slidertrack { border-color: #ffcb00; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
.slider-value { width: 54dp; text-align: right; font-size: 17dp; font-weight: bold; color: #ffd84a; }

.info { padding: 10dp 12dp 14dp; }
.info h3 { font-size: 20dp; font-weight: bold; color: #ffd84a; margin-bottom: 4dp; }
.info p { font-size: 16dp; line-height: 1.5; color: #d8dae6; }
#settings-status { font-size: 14dp; color: #9da2bb; margin: 10dp 12dp 0; }

/* ---- Description bar ---------------------------------------------------- */

#descbar {
    flex-shrink: 0;
    margin: 14dp auto 0;
    width: 72%;
    height: 66dp;  /* two lines, so a long description does not move the menus */
    box-sizing: border-box;
    padding: 9dp 18dp;
    background-color: #05050ee8;
    border: 3dp #b8bccb;
    border-radius: 10dp;
    display: flex;
    align-items: center;
    justify-content: center;
}
#desc {
    font-size: 18dp;
    line-height: 1.3;
    letter-spacing: 0.5dp;
    color: #eeeef6;
    text-align: center;
}

#hints {
    flex-shrink: 0;
    text-align: center;
    font-size: 13dp;
    letter-spacing: 1dp;
    color: #8f94ad;
    padding-top: 6dp;
}
#hints span { margin-left: 26dp; }

/* ---- Platforms ---------------------------------------------------------- */

.mobile .no-mobile { display: none; }
#shader-status { font-size: 16dp; color: #b4b8cc; margin: 6dp 0 0; }

/* ---- Small windows ------------------------------------------------------ */

@media (max-height: 640dp) {
    body { padding: 12dp 16dp 4dp; }
    #titlebar { height: 46dp; margin-top: -20dp; }
    #title, #title-sub { font-size: 28dp; }
    .plate { height: 72dp; line-height: 76dp; font-size: 28dp; }
    .plate.small { height: 52dp; line-height: 55dp; font-size: 22dp; }
    .row { min-height: 38dp; }
    #descbar { height: 56dp; padding: 4dp 14dp; margin-top: 8dp; }
    #desc { font-size: 16dp; }
    #hints { display: none; }
    #disc-name { font-size: 24dp; }
    #disc-panel { padding: 12dp 18dp 12dp 22dp; }
    .note, .update-desc { display: none; }
    #update-card { margin-bottom: 8dp; }
}
@media (max-width: 900dp) {
    body { padding: 12dp 12dp 4dp; }
    #frame { padding: 0 14dp 12dp; }
    #plates { width: 56%; }
    .plate { font-size: 26dp; padding-right: 64dp; }
    .plate.small { font-size: 21dp; }
    #side { margin-left: 18dp; }
    #categories { width: 30%; margin-right: 12dp; }
    button.value, .slider-control, input.text, input.password { width: 190dp; }
    .row .name { font-size: 16dp; }
    #descbar { width: 92%; }
}

.android-only { display: none; }
.android .android-only { display: flex; }
