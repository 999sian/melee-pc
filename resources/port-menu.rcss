/* In-game settings share the launcher's artwork, palette and controls.
 * Keep only overlay-specific layout here; launcher.rcss owns the design. */
/* The game keeps its last frame while paused; tint it rather than covering
 * it with the launcher's opaque backdrop. */
body.port-menu { background-color: #07071a38; decorator: none; }
.port-menu #settings-content { background-color: #0a0c26b8; }
#resume { margin-top: 14dp; margin-left: 6%; }
#quit-game { margin-left: 6%; }
#menu-status {
    font-size: 18dp;
    line-height: 1.3;
    letter-spacing: 0.5dp;
    color: #eeeef6;
    text-align: center;
}
.row .detail { margin-top: 2dp; }
.row { padding-top: 5dp; padding-bottom: 5dp; }
.info h2 { font-size: 20dp; color: #ffd84a; margin: 0; }
@media (max-height: 640dp) {
    #menu-status { font-size: 16dp; }
    .row { padding-top: 3dp; padding-bottom: 3dp; }
}

@media (max-width: 900dp) {
    button.value { font-size: 15dp; padding: 0 18dp; white-space: nowrap; }
    /* The description bar carries these hints in a narrow window. */
    .row .detail { display: none; }
    #pad-name, #port-update-status { display: block; }
}
