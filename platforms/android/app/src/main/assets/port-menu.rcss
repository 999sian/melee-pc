/* Melee palette with a Dusklight-inspired floating settings-window layout. */
* { box-sizing: border-box; }
body { display: flex; flex-direction: column; width: 100%; height: 100%; margin: 0; font-family: "Liberation Sans"; font-size: 15dp; color: #f0f2f5; background-color: #080d1938; }
div, h1, h2, h3, p { display: block; }
#toolbar { display: flex; align-items: center; flex-shrink: 0; height: 64dp; background-color: #080d19e8; border-bottom: 2dp #7187a5; backdrop-filter: blur(5dp); }
.wordmark { margin: 0 28dp; font-size: 19dp; font-weight: bold; letter-spacing: 2dp; }
.muted { color: #a7b6cc; }
.toolbar-tab { height: 64dp; line-height: 64dp; padding: 0 24dp; border-bottom: 4dp #f39832; font-weight: bold; font-size: 18dp; }
.toolbar-note { margin-left: auto; margin-right: 110dp; color: #a7b6cc; font-size: 12dp; letter-spacing: 1dp; }
/* Centred with auto margins, not a transform: RmlUi does not re-apply an
   ancestor transform to a subtree that was display:none when the transform
   state was last computed, so a tab page revealed later drew untransformed. */
#window { display: flex; flex-direction: column; margin: auto; width: 84%; max-width: 1088dp; height: 80%; max-height: 768dp; border: 2dp #7187a5; border-radius: 14dp; background-color: #18263ded; backdrop-filter: blur(5dp); overflow: hidden; }
#heading { display: flex; align-items: center; padding: 20dp 28dp; border-bottom: 1dp #7187a570; background-color: #7187a50b; flex-shrink: 0; }
h1 { font-size: 28dp; margin: 4dp 0 0; }
.version { margin-left: auto; font-size: 12dp; color: #a7b6cc; }
#content { flex: 1; min-height: 0; overflow: auto; padding: 8dp 28dp 20dp; }
#tabstrip { display: flex; flex-shrink: 0; padding: 0 28dp; border-bottom: 1dp #7187a570; }
.tab { width: auto; min-height: 34dp; padding: 8dp 18dp; margin-right: 6dp; border: 0dp #00000000; border-bottom: 3dp #00000000; border-radius: 0; background-color: #00000000; color: #a7b6cc; font-size: 14dp; }
.tab:hover { background-color: #a9c8ef1a; border-bottom-color: #a9c8ef; color: #f0f2f5; }
.tab.selected { border-bottom-color: #f39832; color: #f0f2f5; font-weight: bold; }
.tab:focus { background-color: #f398322b; border-bottom-color: #f39832; color: #f0f2f5; }
.page { display: none; }
.page.selected { display: block; width: 100%; }
#bind-reset, #pad-port { width: 170dp; }
.section { margin-bottom: 16dp; }
.section-heading { padding: 14dp 0 12dp; }
h2 { margin: 0 0 4dp; font-size: 19dp; color: #a9c8ef; }
h3 { margin: 0 0 4dp; font-size: 15dp; font-weight: normal; }
p { margin: 0; font-size: 13dp; line-height: 1.5; color: #a7b6cc; }
.setting { display: flex; align-items: center; padding: 10dp 0; border-bottom: 1dp #7187a528; }
.description { flex: 1; margin-right: 24dp; }
.badge { color: #a9c8ef; font-size: 9dp; margin-left: 8dp; }
button { display: block; flex-shrink: 0; width: 230dp; min-height: 38dp; padding: 9dp 14dp; border: 1dp #7187a580; border-radius: 7dp; background-color: #080d1980; color: #f0f2f5; font-size: 14dp; text-align: center; cursor: pointer; tab-index: auto; }
button:hover { background-color: #a9c8ef33; border-color: #a9c8ef; }
button:focus { background-color: #f398322b; border-color: #f39832; }
button:active { background-color: #f3983244; }
.slider-control { display: flex; align-items: center; flex-shrink: 0; width: 230dp; min-height: 38dp; }
input.range { flex: 1; height: 24dp; margin-right: 12dp; }
input.range slidertrack { height: 6dp; background-color: #080d19; border: 1dp #7187a580; border-radius: 3dp; margin-top: 9dp; }
input.range:focus-visible slidertrack, input.range:hover slidertrack { border-color: #f39832; }
input.range sliderprogress { height: 6dp; background-color: #f39832; border-radius: 3dp; margin-top: 9dp; }
input.range sliderbar { width: 16dp; height: 20dp; margin-top: 2dp; margin-left: -8dp; margin-right: -8dp; background-color: #f39832; border: 1dp #ffda91; border-radius: 4dp; cursor: pointer; }
input.range sliderbar:hover { background-color: #ffda91; border-color: #ffffff; }
input.range sliderbar:active, input.range:focus sliderbar { background-color: #f4be63; border-color: #ffffff; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
.slider-value { flex-shrink: 0; width: 52dp; text-align: right; font-size: 14dp; font-weight: bold; color: #f39832; }
.controls { padding-top: 12dp; }
#bottom { display: flex; align-items: center; padding: 14dp 28dp; border-top: 1dp #7187a570; flex-shrink: 0; }
#menu-status { flex: 1; margin-right: 20dp; }
#resume { width: 170dp; background-color: #7187a530; border-color: #7187a5; }
#resume:focus, #resume:active { background-color: #f398322b; border-color: #f39832; }
#hints { padding: 0 28dp 14dp; color: #a9c8ef; font-size: 11dp; flex-shrink: 0; }
#hints span { margin-left: 20dp; }
scrollbarvertical { width: 8dp; margin: 3dp; }
scrollbarvertical slidertrack { background-color: #080d19; }
scrollbarvertical sliderbar { background-color: #7187a5; border-radius: 4dp; min-height: 24dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
@media (max-width: 760dp) { #window { width: 94%; } #heading, #bottom { padding: 14dp; } #content { padding: 4dp 14dp 12dp; } .description { margin-right: 12dp; } button { width: 180dp; } .toolbar-note, .version { display: none; } #hints { padding: 0 14dp 12dp; } #hints .muted { display: none; } }
@media (max-height: 600dp) { #window { height: 84%; } #heading { padding: 8dp 16dp; } h1 { font-size: 21dp; } }
