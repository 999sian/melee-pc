<rml><head><title>PC enhancements</title><link type="text/rcss" href="port-menu.rcss" /></head>
<body>
<div id="toolbar"><span class="wordmark">MELEE <span class="muted">/ PC</span></span><span class="toolbar-tab">SETTINGS</span><span class="toolbar-note">F1 TO CLOSE</span></div>
<div id="window">
<div id="heading"><h1>PC settings</h1><span class="version">NTSC-U 1.02</span></div>
<div id="tabstrip"><button id="tab-graphics" class="tab">Graphics</button><button id="tab-audio" class="tab">Audio &amp; interface</button><button id="tab-controls" class="tab">Controls</button></div>
<div id="content">
<div id="page-graphics" class="page">
<div class="setting"><div class="description"><h3>Display mode</h3></div><button id="display">Display</button></div>
<div class="setting"><div class="description"><h3>Vertical sync</h3></div><button id="sync">VSync</button></div>
<div class="setting"><div class="description"><h3>Internal resolution</h3><p>Auto follows the window size. Applied when the menu closes.</p></div><div class="slider-control"><input type="range" id="resolution" min="0" max="10" step="1" value="0" /><span id="resolution-val" class="slider-value">Auto</span></div></div>
<div class="setting"><div class="description"><h3>Aspect ratio</h3><p>Applies to fights. Menus and the HUD stay 4:3. Applied when the menu closes.</p></div><button id="aspect">Original 4:3</button></div>
<div class="setting"><div class="description"><h3>Anti-aliasing <span class="badge">RESTART</span></h3></div><button id="aa">Anti-aliasing</button></div>
<div class="setting"><div class="description"><h3>Anisotropic filtering <span class="badge">RESTART</span></h3></div><button id="filter">Filtering</button></div>
<div class="setting"><div class="description"><h3>Post-processing filter</h3><p>Off presents the frame as rendered.</p></div><button id="filter-mode">Off</button></div>
</div>
<div id="page-audio" class="page">
<div class="setting"><div class="description"><h3>Master volume</h3><p>Left/right or drag to adjust.</p></div><div class="slider-control"><input type="range" id="volume" min="0" max="100" step="5" value="100" /><span id="volume-val" class="slider-value">100%</span></div></div>
<div class="setting"><div class="description"><h3>Mute audio</h3></div><button id="mute">Mute</button></div>
<div class="setting"><div class="description"><h3>Performance display</h3></div><button id="fps">FPS counter</button></div>
<div class="setting"><div class="description"><h3>UI scale</h3><p>Scale launcher and overlay elements.</p></div><div class="slider-control"><input type="range" id="scale" min="75" max="150" step="25" value="100" /><span id="scale-val" class="slider-value">100%</span></div></div>
</div>
<div id="page-controls" class="page">
<div class="setting"><div class="description"><h3>Controller</h3><p id="pad-name">No controller connected.</p></div><button id="pad-port">Port 1</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-0">-</h3></div><button id="bind-0">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-1">-</h3></div><button id="bind-1">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-2">-</h3></div><button id="bind-2">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-3">-</h3></div><button id="bind-3">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-4">-</h3></div><button id="bind-4">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-5">-</h3></div><button id="bind-5">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-6">-</h3></div><button id="bind-6">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-7">-</h3></div><button id="bind-7">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-8">-</h3></div><button id="bind-8">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-9">-</h3></div><button id="bind-9">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-10">-</h3></div><button id="bind-10">-</button></div>
<div class="setting"><div class="description"><h3 id="bind-name-11">-</h3></div><button id="bind-11">-</button></div>
<div class="section-heading"><h2>Sticks and triggers</h2></div>
<div class="setting"><div class="description"><h3 id="axis-name-0">-</h3></div><button id="axis-0">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-1">-</h3></div><button id="axis-1">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-2">-</h3></div><button id="axis-2">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-3">-</h3></div><button id="axis-3">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-4">-</h3><p>C-stick</p></div><button id="axis-4">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-5">-</h3><p>C-stick</p></div><button id="axis-5">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-6">-</h3><p>C-stick</p></div><button id="axis-6">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-7">-</h3><p>C-stick</p></div><button id="axis-7">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-8">-</h3></div><button id="axis-8">-</button></div>
<div class="setting"><div class="description"><h3 id="axis-name-9">-</h3></div><button id="axis-9">-</button></div>
<div class="setting"><div class="description"><h3>Restore defaults</h3><p>Put this port back on its default mapping.</p></div><button id="bind-reset">Restore</button></div>
<div class="section controls"><h2>Keyboard</h2><p>WASD / arrows Move · X Attack · Z Special · C / V Jump · Q / E Shield<br/>Tab Grab · Enter Start · IJKL C-stick</p></div>
</div>
</div>
<div id="bottom"><p id="menu-status">Saved automatically.</p><button id="resume">Return to game</button></div>
<div id="hints">ARROWS / D-PAD Navigate <span>ENTER / A Select</span><span>ESC / B / F1 Close</span><span>BACK Opens this menu</span></div>
</div>
</body></rml>
