div, p, h1, h2 { display: block; }
scrollbarvertical { width: 12dp; margin: 2dp; }
scrollbarhorizontal { height: 12dp; margin: 2dp; }
scrollbarvertical slidertrack, scrollbarhorizontal slidertrack { background-color: #111a29; }
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar { background-color: #4c5b73; border-radius: 5dp; min-height: 24dp; min-width: 10dp; }
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover { background-color: #f4be63; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }
body {
    font-family: "Liberation Sans";
    font-size: 18dp;
    color: #e9eef7;
    background-color: #0b101c;
    margin: 0;
    width: 100%; height: 100%; overflow: auto;
}
#shell { width: 86%; max-width: 1080dp; margin: 0 auto; padding: 30dp 0; }
.topline { display: flex; justify-content: space-between; align-items: center; border-bottom: 1dp #293244; padding-bottom: 20dp; }
.brand { color: #f4be63; font-weight: bold; letter-spacing: 2dp; font-size: 16dp; }
.edition { color: #94a1b8; font-size: 13dp; letter-spacing: 1dp; }
.hero { padding: 38dp 0 28dp; }
.eyebrow { font-size: 13dp; letter-spacing: 3dp; color: #f4be63; margin-bottom: 8dp; }
h1 { font-size: 94dp; font-weight: bold; letter-spacing: 7dp; margin: 0; line-height: 1.0; }
h2 { font-size: 27dp; line-height: 1.2; margin: 12dp 0 18dp; }
p { line-height: 1.5; margin: 10dp 0; }
.columns { display: flex; align-items: stretch; }
.menu { width: 35%; margin-right: 24dp; }
button {
    display: block; box-sizing: border-box; width: 100%; min-height: 54dp;
    margin-bottom: 10dp; padding: 15dp 20dp; text-align: left;
    background-color: #192234; border: 2dp #28354c; border-radius: 6dp;
    font-size: 18dp; color: #e9eef7; font-weight: bold; cursor: pointer;
    tab-index: auto;
}
button:hover { background-color: #283951; border-color: #8d9eb7; }
button:focus { border-color: #f4be63; background-color: #2b3547; }
button:active { background-color: #414c61; }
button.primary { background-color: #eeb75e; border-color: #eeb75e; color: #131926; }
button.primary:hover, button.primary:focus { background-color: #ffda91; border-color: #ffffff; }
button:disabled, button.primary:disabled { background-color: #151d2c; color: #69758b; border-color: #222d40; cursor: default; }
button.quiet { background-color: #0b101c; }
.disc-card { box-sizing: border-box; flex: 1; min-width: 0; background-color: #141d2d; border: 1dp #2a364d; border-top: 3dp #eeb75e; border-radius: 8dp; padding: 26dp; }
#disc-name { word-break: break-all; }
#disc-info { color: #c5d0e1; }
.path { color: #8f9fb8; font-size: 13dp; word-break: break-all; }
.divider { height: 1dp; background-color: #2a364d; margin: 22dp 0 18dp; }
.note { font-size: 15dp; color: #98a7bf; }
#status { margin-top: 24dp; padding: 16dp 20dp; background-color: #141e2e; border-left: 3dp #82b8a4; color: #c5ded4; font-size: 16dp; line-height: 1.5; }
#status.error { color: #ffc1b6; border-left-color: #f28f80; background-color: #2c1d25; }
.footer { color: #7f8da5; font-size: 12dp; letter-spacing: 1dp; padding-top: 22dp; }
.footer span { margin-left: 24dp; }
#preferences { display: none; }
#settings-window {
    box-sizing: border-box;
    width: 100%;
    background-color: #18263ded;
    border: 2dp #7187a5;
    border-radius: 14dp;
    overflow: hidden;
    backdrop-filter: blur(5dp);
}
#settings-heading {
    display: flex;
    align-items: center;
    padding: 20dp 28dp;
    border-bottom: 1dp #7187a570;
    background-color: #7187a50b;
}
#settings-heading h2 {
    font-size: 26dp;
    margin: 0;
    color: #f0f2f5;
}
#settings-heading .version {
    margin-left: auto;
    font-size: 12dp;
    color: #a7b6cc;
}
#tabstrip {
    display: flex;
    padding: 0 28dp;
    border-bottom: 1dp #7187a570;
}
.tab {
    width: auto;
    min-width: 0;
    padding: 9dp 18dp;
    margin-right: 6dp;
    border: 0dp #00000000;
    border-bottom: 3dp #00000000;
    border-radius: 0;
    background-color: #00000000;
    color: #a7b6cc;
}
.tab:hover { background-color: #a9c8ef1a; border-bottom-color: #a9c8ef; color: #f0f2f5; }
.tab.selected { border-bottom-color: #f4be63; color: #f0f2f5; font-weight: bold; }
.tab:focus { background-color: #2b3547; border-bottom-color: #f4be63; color: #f0f2f5; }
.page { display: none; }
.page.selected { display: block; width: 100%; }
#settings-content {
    padding: 8dp 28dp 20dp;
    max-height: 520dp;
    overflow: auto;
}
.section { margin-bottom: 16dp; }
.section-heading { padding: 14dp 0 10dp; }
.section-heading h2 { margin: 0; font-size: 19dp; color: #a9c8ef; }
.setting {
    display: flex;
    align-items: center;
    padding: 10dp 0;
    border-bottom: 1dp #7187a528;
}
.setting .description {
    flex: 1;
    margin-right: 24dp;
}
.setting h3 {
    margin: 0 0 4dp;
    font-size: 15dp;
    font-weight: normal;
    color: #f0f2f5;
}
.setting p {
    margin: 0;
    font-size: 13dp;
    line-height: 1.4;
    color: #a7b6cc;
}
.badge {
    color: #a9c8ef;
    font-size: 9dp;
    margin-left: 8dp;
    border: 1dp #7187a580;
    border-radius: 4dp;
    padding: 1dp 5dp;
}
.setting button {
    display: block;
    flex-shrink: 0;
    width: 230dp;
    min-height: 38dp;
    margin-bottom: 0;
    padding: 9dp 14dp;
    font-size: 14dp;
    text-align: center;
    font-weight: normal;
    background-color: #080d1980;
    border: 1dp #7187a580;
    border-radius: 7dp;
    color: #f0f2f5;
}
.setting button:hover {
    background-color: #a9c8ef33;
    border-color: #a9c8ef;
}
.setting button:focus {
    background-color: #f398322b;
    border-color: #f39832;
}
.slider-control {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 230dp;
    min-height: 38dp;
}
input.range {
    flex: 1;
    height: 24dp;
    margin-right: 12dp;
}
input.range slidertrack {
    height: 6dp;
    background-color: #080d19;
    border: 1dp #7187a580;
    border-radius: 3dp;
    margin-top: 9dp;
}
input.range:focus-visible slidertrack, input.range:hover slidertrack {
    border-color: #f39832;
}
input.range sliderprogress {
    height: 6dp;
    background-color: #f39832;
    border-radius: 3dp;
    margin-top: 9dp;
}
input.range sliderbar {
    width: 16dp;
    height: 20dp;
    margin-top: 2dp;
    margin-left: -8dp;
    margin-right: -8dp;
    background-color: #f39832;
    border: 1dp #ffda91;
    border-radius: 4dp;
    cursor: pointer;
}
input.range sliderbar:hover {
    background-color: #ffda91;
    border-color: #ffffff;
}
input.range sliderbar:active, input.range:focus sliderbar {
    background-color: #f4be63;
    border-color: #ffffff;
}
input.range sliderarrowdec, input.range sliderarrowinc {
    width: 0;
    height: 0;
}
.slider-value {
    flex-shrink: 0;
    width: 52dp;
    text-align: right;
    font-size: 14dp;
    font-weight: bold;
    color: #f39832;
}
.controls p {
    color: #a7b6cc;
    font-size: 13dp;
    line-height: 1.6;
    margin: 4dp 0 0;
}
#settings-bottom {
    display: flex;
    align-items: center;
    padding: 14dp 28dp;
    border-top: 1dp #7187a570;
    background-color: #7187a50b;
}
#settings-status {
    flex: 1;
    margin: 0 20dp 0 0;
    font-size: 14dp;
    color: #a7b6cc;
}
#back {
    display: block;
    flex-shrink: 0;
    width: 190dp;
    min-height: 38dp;
    margin-bottom: 0;
    padding: 9dp 16dp;
    font-size: 14dp;
    text-align: center;
}
@media (max-width: 760dp) {
    #shell { width: 90%; padding: 18dp 0; }
    .edition { display: none; }
    .hero { padding: 24dp 0; }
    h1 { font-size: 66dp; }
    .columns { display: block; }
    .menu { width: 100%; margin-right: 0; }
    .disc-card { width: 100%; padding: 20dp; }
    .footer span { margin-left: 12dp; }
    #settings-heading, #settings-bottom { padding: 14dp; }
    #settings-content { padding: 4dp 14dp 12dp; max-height: 420dp; }
    .setting .description { margin-right: 12dp; }
    .setting button, .slider-control { width: 180dp; }
    #back { width: 150dp; }
}
