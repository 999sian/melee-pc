# EditorConfig configuration for melee-pc
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{rml,rcss,html,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
